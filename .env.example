# Browser-visible settings, embedded by Vite at build time.
# Use your existing backend URL and public publishable key; these are not admin credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required by SSR and authenticated server functions at runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required only for privileged admin account management. SERVER ONLY.
# Never prefix this name with VITE_ or put the value in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server listener settings (Nitro defaults to port 3000).
HOST=0.0.0.0
PORT=3000

# Optional: only if scheduling endpoints that use the existing cron auth helper.
# LOVABLE_CRON_SECRET=
# LOVABLE_CRON_SECRET_PREVIOUS=

# Independent PostgreSQL foundation (server/scripts ONLY; never use VITE_).
# Existing routes still use Supabase. These connections have no cloud fallback.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Local Compose requires your own generated password; no default credentials.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Integration tests require a LOCAL PostgreSQL 17 login with CREATEDB permission.
# Point to the postgres maintenance DB, not an application/cloud database.
TEST_DATABASE_ADMIN_URL=

# Browser-visible settings, embedded by Vite at build time.
# Use your existing backend URL and public publishable key; these are not admin credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required by SSR and authenticated server functions at runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required only for privileged admin account management. SERVER ONLY.
# Never prefix this name with VITE_ or put the value in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server listener settings (Nitro defaults to port 3000).
HOST=0.0.0.0
PORT=3000

# Optional: database migration tooling only; not needed to build/start the app.
# LOVABLE_DB_MIGRATION_URL=

# Optional: only if scheduling endpoints that use the existing cron auth helper.
# LOVABLE_CRON_SECRET=
# LOVABLE_CRON_SECRET_PREVIOUS=
